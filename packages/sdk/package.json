{
  "name": "verdict-sdk",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Typed TS client for the Verdict Solana program.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist/", "src/"],
  "scripts": {
    "copy-idl": "node scripts/copy-idl.mjs",
    "build": "pnpm copy-idl && tsc -p tsconfig.json",
    "test": "pnpm copy-idl && ts-mocha -p ./tsconfig.json -t 1000000 test/**/*.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@solana/spl-token": "0.4.8",
    "@solana/web3.js": "1.95.3"
  },
  "devDependencies": {
    "@types/chai": "4.3.16",
    "@types/mocha": "10.0.7",
    "@types/node": "20.14.10",
    "chai": "4.4.1",
    "mocha": "10.7.0",
    "ts-mocha": "10.0.0",
    "typescript": "5.5.3"
  }
}
